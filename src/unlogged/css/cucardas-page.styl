body
  font-family Roboto, Arial

.group-conent
  display grid
  grid-template-columns auto 1fr
  align-items center
  row-gap 0.4em
  column-gap 1em

.repo-line
  display contents

.repo-link
  font-family Consolas
  white-space nowrap
  color #000
  :visited
    color #444


.temporary-dump p
  margin 0
